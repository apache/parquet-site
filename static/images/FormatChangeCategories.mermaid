%%{init: {"look": "classic", "flowchart": {"useMaxWidth": false, "diagramPadding": 4}}}%%
flowchart LR
    subgraph nested["Set of all Changes"]
        direction TB
        nC["Compatible"]
        subgraph nI["Incompatible"]
            direction TB
            nIR["Incorrect Read"]
            subgraph nCF["Correct Failed Read"]
                direction TB
                nPC["Partial Compatibility"]
                nFI["Fully Incompatible"]
                nPC ~~~ nFI
            end
            nIR ~~~ nCF
        end
        nC ~~~ nI
    end

    subgraph tree[" "]
        direction TB
        all(["Set of all Changes"]) --- C(["Compatible"])
        all --- I(["Incompatible"])
        I --- CF(["Correct failed Read"])
        I --- IR(["Incorrect Read"])
        CF --- PC(["Partial Compatibility"])
        CF --- FI(["Fully Incompatible"])
    end

    nested ~~~ tree

    classDef root fill:#cfe2f3,stroke:#555,color:#000
    classDef compat fill:#d9ead3,stroke:#555,color:#000
    classDef incompat fill:#fff2cc,stroke:#555,color:#000
    classDef incorrect fill:#f4cccc,stroke:#555,color:#000
    classDef failed fill:#fce5cd,stroke:#555,color:#000
    classDef partial fill:#f1c232,stroke:#555,color:#000
    classDef full fill:#bf9000,stroke:#555,color:#000
    class all,nested root
    class C,nC compat
    class I,nI incompat
    class IR,nIR incorrect
    class CF,nCF failed
    class PC,nPC partial
    class FI,nFI full
    style tree fill:none,stroke:none
